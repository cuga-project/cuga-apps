# ── Secrets ────────────────────────────────────────────────────────────────
# Real keys live only in local .env files (and Code Engine secrets), never in git.
*.env
!*.env.example

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.venv/
.venv/
**/.venv/
*/.venv_cuga_deploy*
cuga-apps/.venv_cuga_deployer/*
.pytest_cache/

# ── Node / front-end build ───────────────────────────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/

# ── Runtime artifacts (regenerated by the apps; never source) ─────────────────
*.log
**/*.log
.launch_pids
.DS_Store

# CUGA auto-generated policies (intent guards / tool guides / output formatters).
# Regenerated at runtime — not source. Covers .cuga/ and .cuga_<agent>/ dirs.
**/.cuga/
**/.cuga_*/

# Per-app runtime state / caches (apps recreate these on first run).
# NOTE: a few seed .db / .store.json files were committed earlier and stay
# tracked — the rules here only stop NEW ones from being swept in.
cuga-apps/apps/ouroboros/runs/
cuga-apps/apps/ouroboros/.email_store.json
cuga-apps/apps/*/research.db
cuga-apps/apps/arch_diagram/diagrams.db
cuga-apps/apps/ibm_whats_new/.store.json
cuga-apps/apps/web_researcher/.store.json
CUGA_OpenClaw_NemoClaw_DeepAgents_Smolagents_Hermes_Comparison_Revised.docx
.terminal
cuga-apps/docs/architecture_app_anatomy_cloud_advisor.png
cuga-apps/apps/__pycache__/_llm.cpython-311.pyc
cuga-apps/apps/__pycache__/__init__.cpython-311.pyc
cuga-apps/apps/__pycache__/_llm.cpython-311.pyc
cuga-apps/apps/__pycache__/_llm.cpython-311.pyc
*.pyc
