# build/.env.example — copy to build/.env and fill in.
#
# CUGA uses TWO model layers, and BOTH must point at a provider:
#   1. Outer model     — LLM_PROVIDER + LLM_MODEL; built by apps/_llm.py.
#   2. Internal nodes  — planner / coder / final_answer / etc., configured by the
#                        settings TOML named in AGENT_SETTING_CONFIG.
# Pick ONE provider block below — each block sets BOTH layers. Only the provider
# block is required; everything past it (MCP keys) is optional.
#
# Note on AGENT_SETTING_CONFIG: an absolute path (e.g. /app/apps/settings.watsonx.toml)
# loads a repo file baked into the image; a bare name (e.g. settings.openai.toml)
# resolves to the config bundled inside the `cuga` package. CUGA has native
# settings TOMLs for watsonx / openai / litellm / azure / google / groq /
# openrouter / rits — but NOT for anthropic or ollama, which is why both of
# those route their internal nodes through the `openai` platform (see below).

# ════════════════════════════════════════════════════════════════════════════
# Option A — watsonx  (DEFAULT for this image)
# Both layers = watsonx/gpt-oss-120b; settings.watsonx.toml pins every node.
# To use a different watsonx model, change BOTH LLM_MODEL and the model_name
# values in apps/settings.watsonx.toml.
# ════════════════════════════════════════════════════════════════════════════
LLM_PROVIDER=watsonx
LLM_MODEL=openai/gpt-oss-120b
AGENT_SETTING_CONFIG=/app/apps/settings.watsonx.toml
WATSONX_APIKEY=
WATSONX_PROJECT_ID=        # or WATSONX_SPACE_ID
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ════════════════════════════════════════════════════════════════════════════
# Option B — Ollama  (fully local, zero API cost)
# Outer = ChatOllama (LLM_MODEL via OLLAMA_BASE_URL). Internal nodes map to
# settings.openai.toml (platform="openai"); cuga's openai client reads
# OPENAI_BASE_URL + MODEL_NAME, so point them at the SAME Ollama's
# OpenAI-compatible /v1 endpoint.
# Two host prerequisites:
#   • Use host.docker.internal, NOT localhost — the container must reach Ollama
#     running on the host.
#   • Start Ollama listening beyond loopback:  OLLAMA_HOST=0.0.0.0:11434 ollama serve
#     (the macOS Ollama.app binds 127.0.0.1 only, so quit it first).
# gpt-oss:20b is the smallest model that drives CUGA's planner/coder reliably;
# expect minutes per query on a laptop.
# ════════════════════════════════════════════════════════════════════════════
# LLM_PROVIDER=ollama
# LLM_MODEL=gpt-oss:20b
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# AGENT_SETTING_CONFIG=settings.openai.toml
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama          # dummy; Ollama ignores it
# MODEL_NAME=gpt-oss:20b         # model for CUGA's internal nodes

# ════════════════════════════════════════════════════════════════════════════
# Option C — OpenAI
# Both layers native openai (settings.openai.toml = platform="openai").
# ════════════════════════════════════════════════════════════════════════════
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# AGENT_SETTING_CONFIG=settings.openai.toml
# OPENAI_API_KEY=sk-...
# MODEL_NAME=gpt-4o              # model for CUGA's internal nodes

# ════════════════════════════════════════════════════════════════════════════
# Option D — Anthropic (Claude)
# Outer = native Claude via ANTHROPIC_API_KEY. CUGA has NO native anthropic
# platform, so its internal nodes use the openai platform (settings.openai.toml).
# To keep internal nodes on Claude too, point the openai platform at Anthropic's
# OpenAI-compatible endpoint with the SAME Anthropic key. (Alternatively, supply
# a real OpenAI key here to run the internal nodes on GPT — a mixed setup.)
# ════════════════════════════════════════════════════════════════════════════
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_SETTING_CONFIG=settings.openai.toml
# OPENAI_BASE_URL=https://api.anthropic.com/v1/
# OPENAI_API_KEY=sk-ant-...      # same Anthropic key (via the OpenAI-compat layer)
# MODEL_NAME=claude-sonnet-4-6   # model for CUGA's internal nodes

# ── MCP routing ─────────────────────────────────────────────────────────────
# This image BUNDLES the MCP servers and runs them in-container on loopback,
# so leave this as 'local'. (run_all.sh also sets explicit MCP_<NAME>_URL, so
# the apps reach the in-container servers even when deployed on Code Engine.)
CUGA_TARGET=local

# ── MCP service keys (used by the bundled MCP servers) ───────────────────────
# Without a key, that server's tools return a clear "missing key" error and the
# apps relying on them degrade rather than crash. Fill in the ones you need:
#   TAVILY_API_KEY      → mcp-web      → newsletter, web_researcher, youtube_research,
#                                        arch_diagram, webpage_summarizer, ibm_*,
#                                        ouroboros, travel_planner, hiking_research, city_beat
#   OPENTRIPMAP_API_KEY → mcp-geo      → travel_planner, hiking_research, city_beat
#   ALPHA_VANTAGE_API_KEY → mcp-finance→ stock_alert, city_beat
# (mcp-knowledge = Wikipedia, mcp-local = system metrics — no key needed.)
TAVILY_API_KEY=
OPENTRIPMAP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── Optional per-app keys ───────────────────────────────────────────────────
# GITHUB_TOKEN=             # github_trending: raises GitHub API rate limit
# (stock_alert takes the Alpha Vantage key in the browser, per session)

# ── Rate limiting (apps/_ratelimit.py) — defaults are sane; override if needed ─
# RL_PER_MIN=12
# RL_BURST=5
# RL_GLOBAL_PER_MIN=150
# RL_CONCURRENCY=6

# ── Usage tracking (optional; no collector runs in this image by default) ────
# USAGE_COLLECTOR_URL=https://<your-usage-collector>/track
# USAGE_TOKEN=
