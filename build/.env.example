# build/.env.example — copy to build/.env and fill in.
# Only the LLM provider block is required; everything else is optional.

# ── LLM provider (pick ONE block) ───────────────────────────────────────────
# Option A — watsonx
LLM_PROVIDER=watsonx
LLM_MODEL=meta-llama/llama-3-3-70b-instruct
WATSONX_APIKEY=
WATSONX_PROJECT_ID=        # or WATSONX_SPACE_ID

# Option B — RITS (IBM Research) — comment out Option A and use these
# LLM_PROVIDER=rits
# LLM_MODEL=gpt-oss-120b
# RITS_API_KEY=

# Option C — OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=

# ── MCP routing ─────────────────────────────────────────────────────────────
# MCP-backed apps (city_beat, web_researcher, ibm_*, …) call the hosted Code
# Engine MCP servers — their keys (Tavily, OpenTripMap, …) live on CE, not here.
CUGA_TARGET=ce

# ── Optional per-app keys ───────────────────────────────────────────────────
# GITHUB_TOKEN=             # github_trending: raises GitHub API rate limit
# (stock_alert takes the Alpha Vantage key in the browser, per session)

# ── Rate limiting (apps/_ratelimit.py) — defaults are sane; override if needed ─
# RL_PER_MIN=12
# RL_BURST=5
# RL_GLOBAL_PER_MIN=150
# RL_CONCURRENCY=6

# ── Usage tracking (optional; no collector runs in this image by default) ────
# USAGE_COLLECTOR_URL=https://<your-usage-collector>/track
# USAGE_TOKEN=
