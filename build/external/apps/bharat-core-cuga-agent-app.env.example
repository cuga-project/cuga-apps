# App-only values for the bharat-core-cuga-agent-app secret, merged by deploy_external.sh.
#
#     cp bharat-core-cuga-agent-app.env.example bharat-core-cuga-agent-app.env    # gitignored (*.env)
#
# The LLM credentials and USAGE_TOKEN are NOT needed here: deploy_external.sh copies exactly
# those keys from cuga-agent-apps-env (SECRET_KEYS in the .conf). AUTH_MODE=oidc and
# OIDC_REDIRECT_URI are set there too. There is deliberately NO Sarvam key anywhere: each
# user's key stays in their browser and goes straight to api.sarvam.ai.

# ── OIDC sign-in (required — without these the app refuses all traffic) ───────
# The provider's discovery document, e.g.
#   w3id:   https://login.w3.ibm.com/oidc/endpoint/default/.well-known/openid-configuration
#   App ID: https://us-east.appid.cloud.ibm.com/oauth/v4/<tenant>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Signs the session cookie. Generate once:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=
# Optional: who may use it (comma-separated). Empty = anyone the provider signs in.
# AUTH_ALLOWED_EMAIL_DOMAINS=ibm.com,*.ibm.com
# Optional: "post" if the provider wants client_secret_post instead of HTTP Basic.
# OIDC_TOKEN_AUTH=basic

# ── Rate limiting (cuga-apps _ratelimit.py) — per SIGNED-IN USER with OIDC on ──
# per user:  RL_PER_MIN=10  RL_BURST=5  RL_PER_DAY=150
# per app:   RL_GLOBAL_PER_MIN=60  RL_CONCURRENCY=3
