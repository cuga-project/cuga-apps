# syntax=docker/dockerfile:1
# =====================================================================
# Dockerfile.apps — cuga-apps (MCP edition) app container.
#
# One shared image runs every cuga-app; each CE app picks its main.py via
# --command/--argument (see deploy_apps.sh). Carries the union of app deps:
# the LangChain/cuga stack, sqlite-vec (ouroboros policies), feedparser
# (ai_labs_news), chromadb/sentence-transformers (video_qa, deck_forge —
# requirements.apps.heavy.txt), and a headless Chromium for the one
# browser-driven app (meetup_finder).
# =====================================================================
FROM python:3.13-slim

# build-essential covers any C extensions the LangChain stack may need.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.apps.txt requirements.apps.heavy.txt ./
# Lite deps are required by every app. Heavy deps (chromadb, sentence-transformers)
# are only used by video_qa and deck_forge, but the Docker image is the "full"
# install so the whole stack works out of the box. Local dev can skip the
# heavy file — see README.md.
RUN pip install --no-cache-dir -r requirements.apps.txt -r requirements.apps.heavy.txt

# Browser for the one browser-driven app (meetup_finder). `--with-deps`
# pulls the OS libraries Chromium needs (libnss3, libatk, fonts, …) and the
# Chromium build itself. Harmless for the API-only apps — they never import
# playwright. The app launches Chromium with --no-sandbox in-container
# (it detects CUGA_IN_DOCKER / CE_APP).
RUN python -m playwright install --with-deps chromium

# Mark the container so _mcp_bridge resolves service DNS automatically.
ENV CUGA_IN_DOCKER=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY apps/ ./apps/

COPY start.sh /start.sh
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /start.sh /entrypoint.sh

# Secrets are mounted at /run/secrets/app.env at runtime (read-only volume in
# docker-compose.yml). The entrypoint sources them into the process env at
# startup so they never appear in `docker inspect` or in the image itself.
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/start.sh"]
