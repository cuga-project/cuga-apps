# ============================================================================
# cuga-apps (MCP edition) — shared environment file
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#   python3 launch.py          # starts all MCP servers + apps with these env vars
#
# All apps and MCP servers inherit every variable below. App-specific variables
# only apply to the processes that read them — unused variables are silently
# ignored.
# ============================================================================


# ── LLM provider ─────────────────────────────────────────────────────────────
# Used by: all apps (MCP servers do not make LLM calls)
# Options: rits | watsonx | anthropic | openai | ollama | litellm
LLM_PROVIDER=rits
LLM_MODEL=gpt-oss-120b


# ── Anthropic ─────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── RITS (IBM Research Inference-to-Service) ──────────────────────────────────
# RITS_API_KEY=<your key>
# RITS_BASE_URL=https://inference-3scale-apicast-production.apps.rits.fmaas.res.ibm.com


# ── watsonx.ai ────────────────────────────────────────────────────────────────
# WATSONX_APIKEY=your_watsonx_api_key_here
# WATSONX_PROJECT_ID=your_project_id_here
# WATSONX_SPACE_ID=your_space_id_here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com


# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here


# ── Ollama (local, no key needed) ─────────────────────────────────────────────
# OLLAMA_BASE_URL=http://host.docker.internal:11434


# ── LiteLLM proxy ─────────────────────────────────────────────────────────────
# LITELLM_API_KEY=your_litellm_api_key_here
# LITELLM_BASE_URL=https://your-litellm-proxy/


# ── MCP server URLs ───────────────────────────────────────────────────────────
# Where each app's _mcp_bridge connects. Defaults below work for docker compose
# (service DNS) AND localhost dev — the bridge picks the right one based on
# whether it's running inside the docker network.
#
# Override only if you run MCP servers somewhere unusual.
# MCP_WEB_URL=http://mcp-web:29100/mcp
# MCP_KNOWLEDGE_URL=http://mcp-knowledge:29101/mcp
# MCP_GEO_URL=http://mcp-geo:29102/mcp
# MCP_FINANCE_URL=http://mcp-finance:29103/mcp
# MCP_CODE_URL=http://mcp-code:29104/mcp
# MCP_LOCAL_URL=http://mcp-local:29105/mcp


# ── Third-party API keys consumed by MCP servers ─────────────────────────────
# Tavily — required by mcp-web's web_search tool
# Sign up: https://tavily.com
TAVILY_API_KEY=<your key>

# Alpha Vantage — required by mcp-finance's get_stock_quote tool
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=<your key>

# OpenTripMap — required by mcp-geo's search_attractions tool (free tier, 500/day)
# Sign up: https://opentripmap.io/product
OPENTRIPMAP_API_KEY=<your key>


# ── Email / SMTP (optional — used by apps that send digests/alerts) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=<>
SMTP_PASSWORD=<>

ALERT_TO=<>
DIGEST_TO=<>
RESEARCH_TO=<>


# ── Voice / Whisper (voice_journal, stage 2) ─────────────────────────────────
# WHISPER_MODEL=base


# ── Server monitor thresholds (optional — built-in defaults) ─────────────────
# CPU_THRESHOLD=75
# CPU_CRITICAL=90
# RAM_THRESHOLD=80
# RAM_CRITICAL=92
# DISK_THRESHOLD=80
# DISK_CRITICAL=90
# POLL_INTERVAL_SECONDS=60
# ALERT_COOLDOWN_SECONDS=900


# ── Drop summarizer watch directory (stage 2) ────────────────────────────────
# WATCH_DIR=/path/to/your/inbox
# POLL_SECONDS=15


# ── No key needed (MCP servers use these for free) ──────────────────────────
# Wikipedia REST API  — https://en.wikipedia.org/api/rest_v1/
# wttr.in weather     — https://wttr.in/:help
# Nominatim geocoding — https://nominatim.openstreetmap.org/
# arXiv + Semantic Scholar — https://arxiv.org/help/api + https://api.semanticscholar.org/
# CoinGecko crypto prices — https://www.coingecko.com/en/api

# ============================================================================
# Rate limiting (apps/_ratelimit.py) — applies to every app's POST endpoints.
# Defaults are baked in; set these only to override. On Code Engine, put any
# overrides in the `app-env` secret. GET (UI + /session polling) is never
# limited. See apps/_ratelimit.py for the full design + a CIS WAF note.
# ============================================================================
# RL_ENABLED=1            # master switch ("0" disables all limiting)
# RL_PER_MIN=12           # sustained POSTs per minute per client IP
# RL_BURST=5              # short-burst capacity per IP (token-bucket size)
# RL_PER_DAY=300          # hard POSTs per day per IP (0 = off)
# RL_GLOBAL_PER_MIN=150   # POSTs/min across ALL IPs — backstop vs IP rotation (0 = off)
# RL_CONCURRENCY=6        # max concurrent in-flight POSTs (0 = off)
# RL_MAX_BODY_BYTES=32768 # reject POST bodies larger than this (0 = off)
# RL_TRUST_FORWARDED=1    # derive client IP from X-Forwarded-For (needed on CE)

# ============================================================================
# Usage tracking (apps/_usage.py → apps/usage_collector). Lets the collector
# dashboard show which apps are being used. Anonymized (daily-salted IP hash).
#
# LOCAL: launch.py and start.sh auto-point apps at the local collector
#        (http://127.0.0.1:28827/track), so the dashboard "just works". Only
#        set this if you run an app standalone or want a non-default target.
# CODE ENGINE: apps don't use launch.py/start.sh there — set USAGE_COLLECTOR_URL
#        in the `app-env` secret to the collector's PUBLIC url, e.g.
#        https://cuga-apps-usage-collector.<hash>.<region>.codeengine.appdomain.cloud/track
# ============================================================================
# USAGE_COLLECTOR_URL=http://127.0.0.1:28827/track
# USAGE_TOKEN=                # shared secret for POST /track (set in prod)
# USAGE_DASHBOARD_TOKEN=      # if set, dashboard needs ?token=...
# USAGE_SALT=cuga-usage       # anonymization salt
# Durable history on the collector (optional; else a local JSON file is used):
# USAGE_S3_BUCKET=
# USAGE_S3_ENDPOINT=          # e.g. https://s3.us-east.cloud-object-storage.appdomain.cloud
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
